APP_NAME="Dr. Dana E. Roxas Dental Clinic API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Backend Foundation 1B (not yet wired) will run the Vite dev server on this origin.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the intended development/production database for this project. Point these at a local
# Postgres server; see backend/README.md for setup. Do not put a real password in this tracked file.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dental_clinic
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# M17 realtime: reverb (run `php artisan reverb:start`). `log`/`null` disables live updates; Messages still work by polling.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (M18). Local default `log` sends nothing (it only writes to storage/logs). For real delivery:
#   Gmail (development/defense): MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=smtp (STARTTLS),
#   MAIL_USERNAME=<the Gmail address>, MAIL_PASSWORD=<a Google app password; needs 2-Step Verification>,
#   MAIL_FROM_ADDRESS=<the same Gmail address>. Gmail limits daily sending, so a sold deployment should use a
#   transactional provider (for example Brevo or Resend) with the clinic's own domain - only these variables change.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# M18 durable email: total tries per queued email, and when a stuck claim is retaken (seconds).
MAIL_MAX_ATTEMPTS=4
MAIL_PROCESSING_TIMEOUT_SECONDS=600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo Payment Gateway Integration
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com
PAYMONGO_MODE=
PAYMONGO_PAYMENT_METHOD_TYPES=

# M7 Patient AI Support (server-side only; no defaults — unset means the assistant is disabled)
ASSISTANT_PROVIDER=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_API_VERSION=2023-06-01
ASSISTANT_TIMEOUT_SECONDS=20
ASSISTANT_MAX_OUTPUT_TOKENS=400
ASSISTANT_RATE_PER_MINUTE=6
ASSISTANT_RATE_PER_HOUR=60

# M1 employee invitations: hours a set-password link stays valid (engineering default pending PI-02).
EMPLOYEE_INVITATION_EXPIRE_HOURS=72

# M1 one-time codes (registration, password reset, email change) and account notices: send caps per email+IP per hour
# and per email per day (engineering security defaults, counted before any account lookup).
OTP_HOURLY_PER_EMAIL_IP=5
OTP_DAILY_PER_EMAIL=10

# Optional contact address printed in email footers. Leave empty to show none (no address is invented).
CLINIC_SUPPORT_EMAIL=

# M17 messaging send limits per account (a technical abuse bound, not clinic policy).
MESSAGING_RATE_PER_MINUTE=20
MESSAGING_RATE_PER_HOUR=200
# New front-desk conversations a Patient may start per hour; "in the app" window for presence; one offline email alert per
# conversation per cooldown (engineering defaults).
MESSAGING_START_PER_HOUR=5
MESSAGING_ONLINE_SECONDS=90
MESSAGING_ALERT_COOLDOWN_MINUTES=15

# Demo/dev seed accounts only (never production). Leave empty to use the seeder's local-only fallback.
DEMO_ACCOUNT_PASSWORD=

# M17 realtime (Laravel Reverb). Generate your own values (e.g. `php artisan reverb:install`, or random strings); never commit them.
# The frontend needs the same REVERB_APP_KEY as VITE_REVERB_APP_KEY in the root .env.local. In production use wss (REVERB_SCHEME=https)
# behind the same TLS proxy as the API.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
