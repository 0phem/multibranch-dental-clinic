# Copy to backend/.env.testing (gitignored) and fill in your local PostgreSQL connection details.
# phpunit.xml already fixes DB_CONNECTION=pgsql and DB_DATABASE=dental_clinic_test; this file supplies
# the machine-specific host/port/credentials so no personal username/password is ever committed.
#
# Sanctum's stateful SPA middleware pulls in cookie encryption during tests, which needs its own app key —
# separate from the real backend/.env key. Leave this blank, then run:
#   php artisan key:generate --env=testing
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=your_local_postgres_role
DB_PASSWORD=

# Matches the Vite dev server origin the Feature tests simulate via a Referer header (see tests/TestCase.php),
# so Sanctum's stateful-SPA session middleware actually runs during tests, same as it will for Backend 1B.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
