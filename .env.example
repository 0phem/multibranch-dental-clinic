# Copy to .env (gitignored) if you need to override this locally. The default already matches
# backend/README.md's local setup (php artisan serve on port 8000).
VITE_API_BASE_URL=http://localhost:8000

# M17 realtime (Laravel Reverb). Copy the app KEY (not the secret) from backend/.env REVERB_APP_KEY. Leave the key empty to run without
# a socket: Messages then refresh by polling every 10 seconds.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
